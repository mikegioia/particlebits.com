<script src="<?php $a('data'); ?>"></script>
<script>
(function () {
    var app = document.getElementById('pq-app');
    var answers = {};

    PrivacyQuiz.categories.forEach(function (category) {
        answers[category.key] = {};
        PrivacyQuiz.spheres.forEach(function (sphere) {
            answers[category.key][sphere.key] = {
                actual: null,
                desired: null
            };
        });
    });

    // -1 = intro, 0..5 = category screens, 6 = results
    var screen = -1;
    var previewMode = /[?&]preview=results\b/.test(window.location.search);
    // #app-side is rendered by the page template *after* this article's
    // markup (and this inline script), so it does not exist in the DOM yet
    // at parse time. Resolve it lazily on first use instead of caching a
    // premature (and permanently null) lookup here.
    var sideSlot = null;
    var appAction = document.getElementById('app-action');
    var intro = document.getElementById('pq-intro');

    function answeredCount() {
        var count = 0;

        PrivacyQuiz.categories.forEach(function (category) {
            PrivacyQuiz.spheres.forEach(function (sphere) {
                var cell = answers[category.key][sphere.key];

                count += (cell.actual !== null ? 1 : 0)
                    + (cell.desired !== null ? 1 : 0);
            });
        });

        return count;
    }

    function progressPercent() {
        var total = PrivacyQuiz.categories.length
            * PrivacyQuiz.spheres.length * 2;

        return Math.round(100 * answeredCount() / total);
    }

    function progressLabel(index, percent) {
        return 'Category ' + (index + 1) + ' of '
            + PrivacyQuiz.categories.length + ' (' + percent + '%)';
    }

    function progressHtml(index) {
        var percent = progressPercent();

        return '<div class="pq-progress">'
            + '<div class="pq-pfill" style="width:' + percent + '%"></div>'
            + '<div class="pq-plabel">' + progressLabel(index, percent)
            + '</div></div>';
    }

    function updateProgress(index) {
        var fill = app.querySelector('.pq-pfill');
        var label = app.querySelector('.pq-plabel');
        var percent = progressPercent();

        if (fill) {
            fill.style.width = percent + '%';
        }

        if (label) {
            label.innerHTML = progressLabel(index, percent);
        }
    }

    function showValidation(index) {
        var category = PrivacyQuiz.categories[index];
        var first = null;

        PrivacyQuiz.spheres.forEach(function (sphere) {
            var cell = answers[category.key][sphere.key];

            ['actual', 'desired'].forEach(function (field) {
                if (cell[field] !== null) {
                    return;
                }

                var input = app.querySelector('input[name="' + category.key
                    + '-' + sphere.key + '-' + field + '"]');
                var row = input && input.closest('.pq-rating');

                if (row) {
                    row.classList.add('pq-missing');
                    first = first || row;
                }
            });
        });

        var msg = document.getElementById('pq-invalid-msg');

        if (msg) {
            msg.hidden = false;
        }

        if (first) {
            first.scrollIntoView({ block: 'center' });
        }
    }

    function renderSide() {
        sideSlot = sideSlot || document.getElementById('app-side');

        if (!sideSlot) {
            return;
        }

        if (screen === -1) {
            sideSlot.innerHTML = '';
            return;
        }

        if (screen < PrivacyQuiz.categories.length) {
            sideSlot.innerHTML =
                '<button id="pq-next" class="pq-button pq-primary">'
                + (screen === PrivacyQuiz.categories.length - 1
                    ? 'See my results' : 'Next')
                + '</button>'
                + '<button id="pq-back" class="pq-button pq-secondary">Back</button>'
                + '<div id="pq-invalid-msg" class="pq-invalid-msg" hidden>'
                + 'Please answer the highlighted rows.</div>';

            document.getElementById('pq-next').onclick = function () {
                if (!isScreenComplete(screen)) {
                    showValidation(screen);
                    return;
                }

                screen += 1;

                if (screen === PrivacyQuiz.categories.length) {
                    saveResults();
                }

                render();
            };
            document.getElementById('pq-back').onclick = function () {
                screen -= 1;
                render();
            };
            return;
        }

        sideSlot.innerHTML =
            '<button id="pq-print" class="pq-button pq-primary">'
            + 'Print my results</button>'
            + '<button id="pq-retake" class="pq-button pq-secondary">'
            + 'Start over</button>'
            + '<button id="pq-back" class="pq-button pq-secondary">Back</button>';

        document.getElementById('pq-print').onclick = function () {
            window.print();
        };
        document.getElementById('pq-retake').onclick = function () {
            resetQuiz();
        };
        document.getElementById('pq-back').onclick = function () {
            screen -= 1;
            render();
        };
    }

    function resetQuiz() {
        PrivacyQuiz.categories.forEach(function (category) {
            PrivacyQuiz.spheres.forEach(function (sphere) {
                answers[category.key][sphere.key].actual = null;
                answers[category.key][sphere.key].desired = null;
            });
        });
        screen = -1;
        render();
    }

    var STORAGE_KEY = 'pq-results';

    function saveResults() {
        try {
            window.localStorage.setItem(STORAGE_KEY, JSON.stringify({
                savedAt: new Date().toISOString(),
                answers: answers
            }));
        } catch (e) {
            // Storage unavailable (private browsing, disabled); the
            // quiz still works, results just are not kept.
        }
    }

    function loadResults() {
        var data;

        try {
            data = JSON.parse(window.localStorage.getItem(STORAGE_KEY));
        } catch (e) {
            return null;
        }

        if (!data || !data.answers) {
            return null;
        }

        var valid = PrivacyQuiz.categories.every(function (category) {
            var row = data.answers[category.key];

            return row && PrivacyQuiz.spheres.every(function (sphere) {
                var cell = row[sphere.key];

                return cell && typeof cell.actual === 'number'
                    && typeof cell.desired === 'number';
            });
        });

        if (!valid) {
            return null;
        }

        var date = new Date(data.savedAt);

        data.label = isNaN(date)
            ? ''
            : date.toLocaleDateString(undefined,
                { month: 'short', day: 'numeric' });

        return data;
    }

    function applyAnswers(saved) {
        PrivacyQuiz.categories.forEach(function (category) {
            PrivacyQuiz.spheres.forEach(function (sphere) {
                var cell = saved[category.key][sphere.key];

                answers[category.key][sphere.key].actual = cell.actual;
                answers[category.key][sphere.key].desired = cell.desired;
            });
        });
    }

    function render() {
        if (screen === -1) {
            renderIntro();
        } else if (screen < PrivacyQuiz.categories.length) {
            renderCategory(screen);
        } else {
            renderResults();
        }

        renderSide();

        if (intro) {
            intro.style.display = screen === -1 ? '' : 'none';
        }

        window.scrollTo(0, 0);
    }

    function renderIntro() {
        var saved = loadResults();

        app.innerHTML =
            '<button id="pq-next" class="pq-button pq-primary pq-start">'
            + 'Start the quiz</button>'
            + (saved
                ? '<button id="pq-view" class="pq-button pq-results pq-start">'
                    + 'See my latest results'
                    + (saved.label ? ' (' + saved.label + ')' : '')
                    + '</button>'
                : '')
            + '<img class="pq-hero" src="<?php $a('spheres'); ?>" '
            + 'alt="Illustration of the six spheres of privacy">';

        document.getElementById('pq-next').onclick = function () {
            screen = 0;
            render();
        };

        var view = document.getElementById('pq-view');

        if (view) {
            view.onclick = function () {
                applyAnswers(saved.answers);
                screen = PrivacyQuiz.categories.length;
                render();
            };
        }
    }

    function isScreenComplete(index) {
        var category = PrivacyQuiz.categories[index];

        return PrivacyQuiz.spheres.every(function (sphere) {
            var cell = answers[category.key][sphere.key];

            return cell.actual !== null && cell.desired !== null;
        });
    }

    function ratingRow(category, sphere, field, label) {
        var name = category.key + '-' + sphere.key + '-' + field;
        var current = answers[category.key][sphere.key][field];

        return '<div class="pq-rating"><span class="pq-q">' + label + '</span>'
            + '<span class="pq-options">'
            + PrivacyQuiz.scale.map(function (option, value) {
                return '<label><input type="radio" name="' + name
                    + '" value="' + value + '"'
                    + (current === value ? ' checked' : '')
                    + '> ' + option + '</label>';
            }).join('')
            + '</span></div>';
    }

    function renderCategory(index) {
        var category = PrivacyQuiz.categories[index];

        app.innerHTML =
            progressHtml(index)
            + '<h3 class="pq-cat-head">' + category.name + '</h3>'
            + '<p class="pq-audience pq-cat-desc">' + category.description + '</p>'
            + PrivacyQuiz.spheres.map(function (sphere) {
                return '<fieldset class="pq-sphere">'
                    + '<div class="pq-sphere-head"><b>' + sphere.name
                    + '</b> <span class="pq-sphere-aud">&ndash; '
                    + sphere.audience + '</span></div>'
                    + ratingRow(category, sphere, 'actual', 'I currently share:')
                    + ratingRow(category, sphere, 'desired', 'I want to share:')
                    + '</fieldset>';
            }).join('');

        app.querySelectorAll('input[type=radio]').forEach(function (input) {
            input.onchange = function () {
                var parts = input.name.split('-');

                answers[parts[0]][parts[1]][parts[2]] =
                    parseInt(input.value, 10);

                var row = input.closest('.pq-rating');

                if (row) {
                    row.classList.remove('pq-missing');
                }

                if (isScreenComplete(index)) {
                    var msg = document.getElementById('pq-invalid-msg');

                    if (msg) {
                        msg.hidden = true;
                    }
                }

                updateProgress(index);
            };
        });
    }

    function badgeClass(band) {
        if (band === 'Balanced') {
            return 'pq-balanced';
        }

        return band === 'Minor imbalance' ? 'pq-minor' : 'pq-major';
    }

    var PQ_COLORS = {
        health: '#2a78d6',
        money: '#eb6834',
        romantic: '#1baf7a',
        beliefs: '#eda100',
        emotions: '#e87ba4',
        daily: '#008300'
    };

    function categoryWeights() {
        return PrivacyQuiz.categories.map(function (category) {
            var weight = 0;

            PrivacyQuiz.spheres.forEach(function (sphere) {
                var cell = answers[category.key][sphere.key];

                weight += Math.abs(
                    PrivacyQuiz.gap(cell.actual, cell.desired));
            });

            return {
                key: category.key,
                name: category.name,
                weight: weight
            };
        });
    }

    function renderChart(selectedKey) {
        var extra = document.getElementById('pq-results-extra');
        var hadFocus = extra.contains(document.activeElement);
        var weights = categoryWeights();
        var total = weights.reduce(function (sum, w) {
            return sum + w.weight;
        }, 0);

        if (total === 0) {
            extra.innerHTML = '';
            return;
        }

        var max = weights.reduce(function (best, w) {
            return Math.max(best, w.weight);
        }, 0);
        var sorted = weights.slice().sort(function (a, b) {
            return b.weight - a.weight;
        });
        var selected = weights.find(function (w) {
            return w.key === selectedKey;
        });
        var items = PrivacyQuiz.actionItems(answers).filter(function (item) {
            return item.categoryKey === selectedKey;
        });

        extra.innerHTML =
            '<div class="pq-chart">'
            + sorted.map(function (w) {
                if (w.weight === 0) {
                    return '<div class="pq-bar-row pq-zero">'
                        + '<span class="pq-bar-label">' + w.name + '</span>'
                        + '<span class="pq-bar-note">balanced &mdash; '
                        + '0 pts</span></div>';
                }

                var isSelected = w.key === selectedKey;

                return '<button type="button" class="pq-bar-row'
                    + (isSelected ? ' pq-selected' : '')
                    + '" data-key="' + w.key + '"'
                    + ' aria-pressed="' + isSelected + '">'
                    + '<span class="pq-bar-label">' + w.name + '</span>'
                    + '<span class="pq-bar-track"><span class="pq-bar" '
                    + 'style="width:' + (100 * w.weight / max).toFixed(1)
                    + '%;background:' + PQ_COLORS[w.key] + '"></span></span>'
                    + '<span class="pq-bar-val">' + w.weight
                    + (w.weight === 1 ? ' pt' : ' pts') + ' &middot; '
                    + Math.round(100 * w.weight / total) + '%</span>'
                    + '</button>';
            }).join('')
            + '</div>'
            + '<div class="pq-panel pq-screen-only">'
            + '<h4>Recommendations: ' + selected.name + '</h4>'
            + (items.length === 0
                ? '<p>No single gap here is 2 or more &mdash; small '
                    + 'adjustments only.</p>'
                : '<ol>' + items.map(function (item) {
                    return '<li>' + item.text + '</li>';
                }).join('') + '</ol>')
            + '</div>';

        extra.querySelectorAll('button.pq-bar-row').forEach(function (el) {
            el.onclick = function () {
                renderChart(el.getAttribute('data-key'));
            };
        });

        if (hadFocus) {
            var focusTarget = extra.querySelector('.pq-bar-row.pq-selected');

            if (focusTarget) {
                focusTarget.focus();
            }
        }
    }

    function printActionsHtml(items) {
        if (items.length === 0) {
            return '';
        }

        return '<div class="pq-print-only">'
            + PrivacyQuiz.categories.map(function (category) {
                var catItems = items.filter(function (item) {
                    return item.categoryKey === category.key;
                });

                if (catItems.length === 0) {
                    return '';
                }

                return '<h4>Recommendations: ' + category.name + '</h4>'
                    + '<ol>' + catItems.map(function (item) {
                        return '<li>' + item.text + '</li>';
                    }).join('') + '</ol>';
            }).join('')
            + '</div>';
    }

    function renderResults() {
        var items = PrivacyQuiz.actionItems(answers);
        var printedOn = new Date().toLocaleDateString(undefined,
            { year: 'numeric', month: 'long', day: 'numeric' });

        app.innerHTML =
            '<div class="pq-print-only pq-print-head">The 15-Minute '
            + 'Privacy Quiz &middot; particlebits.com &middot; '
            + printedOn + '</div>'
            + '<h3>Your Privacy Balance</h3>'
            + (items.length === 0
                ? '<p>No action items &mdash; every gap is small. Your '
                    + 'sharing closely matches your intent.</p>'
                : '<p class="pq-audience">The chart shows how much each '
                    + 'category contributes to your overall imbalance.'
                    + '<span class="pq-screen-only"> Click a category to '
                    + 'see its recommendations.</span></p>')
            + '<div id="pq-results-extra"></div>'
            + printActionsHtml(items)
            + '<h3>Sphere by sphere</h3>'
            + '<p class="pq-audience">Scores measure the gap between what '
            + 'you share and what you want to share &mdash; per sphere, '
            + 'out of a possible 24.</p>'
            + PrivacyQuiz.spheres.map(function (sphere) {
                var result = PrivacyQuiz.sphereResult(answers, sphere.key);

                return '<div class="pq-card topic-privacy-border"><h3>'
                    + sphere.name
                    + ' <span class="pq-badge ' + badgeClass(result.band)
                    + '">' + result.band + ' &middot; ' + result.score
                    + '</span></h3>'
                    + '<p>' + result.verdict + '</p></div>';
            }).join('')
            ;

        if (items.length > 0) {
            var heaviest = categoryWeights().reduce(function (best, w) {
                return w.weight > best.weight ? w : best;
            });

            renderChart(heaviest.key);
        }
    }

    // Fixed sample answers for ?preview=results: exercises Major/over,
    // Minor/under, Minor/mixed, Balanced-nonzero, Balanced-zero, a
    // zero-weight grayed category, and a category with no action items.
    var PQ_SAMPLE = [
        ['money', 'professional', 4, 0],
        ['beliefs', 'professional', 4, 1],
        ['daily', 'professional', 3, 1],
        ['emotions', 'family', 0, 3],
        ['daily', 'family', 1, 3],
        ['money', 'social', 4, 1],
        ['emotions', 'social', 0, 3],
        ['romantic', 'private', 3, 4]
    ];

    function applySample() {
        PrivacyQuiz.categories.forEach(function (category) {
            PrivacyQuiz.spheres.forEach(function (sphere) {
                answers[category.key][sphere.key].actual = 2;
                answers[category.key][sphere.key].desired = 2;
            });
        });

        PQ_SAMPLE.forEach(function (row) {
            answers[row[0]][row[1]].actual = row[2];
            answers[row[0]][row[1]].desired = row[3];
        });
    }

    if (previewMode) {
        applySample();
        screen = PrivacyQuiz.categories.length;
    }

    if (appAction) {
        appAction.hidden = false;
        appAction.textContent = 'End Quiz';
        appAction.onclick = function (event) {
            event.preventDefault();

            var inQuiz = screen >= 0
                && screen < PrivacyQuiz.categories.length;

            if (inQuiz && answeredCount() > 0 && !window.confirm(
                    'End the quiz? Your answers so far will be lost.')) {
                return;
            }

            resetQuiz();
        };
    }

    window.addEventListener('beforeunload', function (event) {
        var inQuiz = screen >= 0 && screen < PrivacyQuiz.categories.length;

        if (!previewMode && inQuiz && answeredCount() > 0) {
            event.preventDefault();
            event.returnValue = '';
        }
    });

    // The initial render populates #app-side (see above), which is only
    // safe once the rest of the document (including that element) has
    // been parsed.
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', render);
    } else {
        render();
    }
})();
</script>
